-- UPDATE UI
local function updateUI()
    local t = translations[language]

    status.Text = enabled and t.active or t.inactive
    status.TextColor3 = enabled and GREEN or WHITE

    counter.Text = t.clicks .. clicks
    toggle.Text = enabled and t.stop or t.start
    speed.Text = string.format(t.delay,clickDelay)
    hint.Text = t.hint

    plButton.BackgroundColor3 =
        language == "PL" and GOLD_DARK or DARK2

    enButton.BackgroundColor3 =
        language == "EN" and GOLD_DARK or DARK2

    plButton.TextColor3 =
        language == "PL" and GOLD or WHITE

    enButton.TextColor3 =
        language == "EN" and GOLD or WHITE
end

local function toggleFish()
    if not running then return end
    enabled = not enabled
    updateUI()
end

