        if processed or not running then return end

        if input.KeyCode == Enum.KeyCode.M then
            toggleFish()
        end
    end)
)

-- DRAGGABLE WINDOW
local dragging = false
local dragStart
local startPosition

table.insert(connections,
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = panel.Position
        end
    end)
)

table.insert(connections,
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
)

table.insert(connections,
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position-dragStart

            panel.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset+delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset+delta.Y
            )
        end
    end)
)

-- FIND HAND
local function findHand()
    local fg = pg:FindFirstChild("FishingGui")
    local fishing = fg and fg:FindFirstChild("Fishing")
    local hand = fishing
        and fishing:FindFirstChild("ClickSpeedUpActive")

    if hand
        and hand:IsA("GuiObject")
        and hand.Visible
        and hand.AbsoluteSize.X > 0
        and hand.AbsoluteSize.Y > 0 then
        return hand
    end

    return nil
end

-- AUTO CLICK WITHOUT MOVING CURSOR
table.insert(connections,
    RunService.Heartbeat:Connect(function()
        if not running or not enabled then return end

        local hand = findHand()
        if not hand then return end

        if os.clock()-lastClick < clickDelay then
            return
        end

        local p = hand.AbsolutePosition
        local s = hand.AbsoluteSize

        local x = p.X+s.X/2
        local y = p.Y+s.Y/2+45

        lastClick = os.clock()

        local ok,err = pcall(function()
            VIM:SendMouseButtonEvent(
                x,y,0,true,game,0
            )
            VIM:SendMouseButtonEvent(
                x,y,0,false,game,0
            )
        end)

        if ok then
            clicks += 1
            updateUI()
        else
            enabled = false
            updateUI()
            status.Text = translations[language].error
            warn(err)
        end
    end)
)

-- FULL STOP
local function stopScript()
    if not running then return end

    running = false
    enabled = false

    for _,connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()
end

env.GoatiniAutoFishStop = stopScript

table.insert(connections,
    close.MouseButton1Click:Connect(function()
        stopScript()
        env.GoatiniAutoFishStop = nil
    end)
)

